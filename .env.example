SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_ENV=development
DATABASE_URL_DEV=postgresql://user:password@localhost:5432/smartdoc_db
DATABASE_URL_PROD=postgresql://user:password@localhost:5432/smartdoc_db
REDIS_URL=redis://127.0.0.1:6379/1

# System rate limit (DRF throttle)
SYSTEM_ANON_RATE=100/hour
SYSTEM_USER_RATE=1000/hour

# Business rate limit (endpoint-level)
BUSINESS_ME_LIMIT=30
BUSINESS_ME_WINDOW_SECONDS=60
BUSINESS_USERS_LIST_LIMIT=20
BUSINESS_USERS_LIST_WINDOW_SECONDS=60

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_HOSTS=localhost,127.0.0.1

# Hugging Face API key
HF_TOKEN=your-hugging-face-api-key-here

# LMM Model API
# DEEPSEEK
DEEPSEEK_API_KEY=your-deepseek-api-key-here