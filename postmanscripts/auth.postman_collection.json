    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "if (response.data && response.data.access_token) {",
              "    pm.environment.set(\"access_token\", response.data.access_token);",
              "    console.log(\"Đã fill token vào Environment.\");",
              "} else {",
              "    console.log(\"Không tìm thấy access_token trong response\");",
              "}"
            ],
